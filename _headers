# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprint-free asset paths, so cache briefly and revalidate.
/assets/*
  Cache-Control: public, max-age=604800

# Fonts never change once published.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML must always be revalidated so edits go live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS and JS carry no content hash, so keep them revalidating too.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate
